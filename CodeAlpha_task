import java.io.*;
import java.util.*;

/**
 * Stock Trading Platform (simulation) - CodeAlpha Java Programming Internship
 * Features: market data, buy/sell, portfolio tracking with profit/loss,
 * transaction history, daily price changes, and saving to a file.
 */
public class StockTradingPlatform {

    // ---------- Models ----------
    static class Stock {
        final String symbol;
        final String name;
        double price;

        Stock(String symbol, String name, double price) {
            this.symbol = symbol;
            this.name = name;
            this.price = price;
        }
    }

    static class Holding {
        int quantity;
        double totalCost;

        double averageCost() {
            return quantity == 0 ? 0 : totalCost / quantity;
        }
    }

    // ---------- State ----------
    private static final String FILE_NAME = "portfolio.txt";
    private static final double STARTING_CASH = 100000;

    private static final Map<String, Stock> market = new LinkedHashMap<>();
    private static final Map<String, Holding> portfolio = new LinkedHashMap<>();
    private static final List<String> history = new ArrayList<>();
    private static final Scanner sc = new Scanner(System.in);
    private static final Random random = new Random();

    private static double cash = STARTING_CASH;
    private static int day = 1;

    // ---------- Main ----------
    public static void main(String[] args) {
        setupMarket();
        loadPortfolio();
        System.out.println("=== STOCK TRADING PLATFORM (SIMULATION) ===");
        boolean running = true;
        while (running) {
            System.out.printf("%nDay %d | Cash: Rs.%.2f%n", day, cash);
            System.out.println("1. View market");
            System.out.println("2. Buy stock");
            System.out.println("3. Sell stock");
            System.out.println("4. View portfolio");
            System.out.println("5. Transaction history");
            System.out.println("6. Next day (update prices)");
            System.out.println("7. Save and exit");
            switch (readInt("Enter choice: ")) {
                case 1: viewMarket(); break;
                case 2: buyStock(); break;
                case 3: sellStock(); break;
                case 4: viewPortfolio(); break;
                case 5: viewHistory(); break;
                case 6: nextDay(); break;
                case 7: running = false; break;
                default: System.out.println("Invalid choice. Try 1-7.");
            }
        }
        savePortfolio();
        System.out.println("Portfolio saved. Goodbye!");
    }

    // ---------- Setup ----------
    private static void setupMarket() {
        addStock("TCS", "Tata Consultancy", 3500);
        addStock("INFY", "Infosys", 1500);
        addStock("RELIANCE", "Reliance Industries", 2400);
        addStock("HDFCBANK", "HDFC Bank", 1600);
        addStock("WIPRO", "Wipro", 450);
    }

    private static void addStock(String symbol, String name, double price) {
        market.put(symbol, new Stock(symbol, name, price));
    }

    // ---------- Features ----------
    private static void viewMarket() {
        System.out.printf("%n%-10s %-22s %-10s%n", "Symbol", "Company", "Price");
        System.out.println("------------------------------------------");
        for (Stock s : market.values()) {
            System.out.printf("%-10s %-22s Rs.%.2f%n", s.symbol, s.name, s.price);
        }
    }

    private static void buyStock() {
        viewMarket();
        Stock s = readStock();
        if (s == null) return;
        int qty = readInt("Quantity to buy: ");
        if (qty <= 0) {
            System.out.println("Quantity must be positive.");
            return;
        }
        double cost = qty * s.price;
        if (cost > cash) {
            System.out.printf("Not enough cash. Need Rs.%.2f, have Rs.%.2f.%n", cost, cash);
            return;
        }
        cash -= cost;
        Holding h = portfolio.computeIfAbsent(s.symbol, k -> new Holding());
        h.quantity += qty;
        h.totalCost += cost;
        history.add(String.format("Day %d: BUY %d %s @ %.2f", day, qty, s.symbol, s.price));
        System.out.printf("Bought %d x %s for Rs.%.2f%n", qty, s.symbol, cost);
    }

    private static void sellStock() {
        if (portfolio.isEmpty()) {
            System.out.println("You do not own any stocks.");
            return;
        }
        Stock s = readStock();
        if (s == null) return;
        Holding h = portfolio.get(s.symbol);
        if (h == null) {
            System.out.println("You do not own " + s.symbol + ".");
            return;
        }
        int qty = readInt("Quantity to sell (you own " + h.quantity + "): ");
        if (qty <= 0 || qty > h.quantity) {
            System.out.println("Invalid quantity.");
            return;
        }
        double proceeds = qty * s.price;
        double costBasis = qty * h.averageCost();
        cash += proceeds;
        h.totalCost -= costBasis;
        h.quantity -= qty;
        if (h.quantity == 0) portfolio.remove(s.symbol);
        history.add(String.format("Day %d: SELL %d %s @ %.2f", day, qty, s.symbol, s.price));
        System.out.printf("Sold %d x %s for Rs.%.2f (%s Rs.%.2f)%n", qty, s.symbol, proceeds,
                proceeds >= costBasis ? "profit" : "loss", Math.abs(proceeds - costBasis));
    }

    private static void viewPortfolio() {
        double holdingsValue = 0;
        if (portfolio.isEmpty()) {
            System.out.println("\nNo holdings yet.");
        } else {
            System.out.printf("%n%-10s %-5s %-10s %-10s %-12s %-10s%n",
                    "Symbol", "Qty", "Avg cost", "Price", "Value", "P/L");
            System.out.println("------------------------------------------------------------");
            for (Map.Entry<String, Holding> e : portfolio.entrySet()) {
                Holding h = e.getValue();
                double price = market.get(e.getKey()).price;
                double value = h.quantity * price;
                holdingsValue += value;
                System.out.printf("%-10s %-5d %-10.2f %-10.2f %-12.2f %+.2f%n",
                        e.getKey(), h.quantity, h.averageCost(), price, value, value - h.totalCost);
            }
        }
        double netWorth = cash + holdingsValue;
        System.out.printf("%nCash          : Rs.%.2f%n", cash);
        System.out.printf("Holdings value: Rs.%.2f%n", holdingsValue);
        System.out.printf("Net worth     : Rs.%.2f%n", netWorth);
        System.out.printf("Overall P/L   : %+.2f%n", netWorth - STARTING_CASH);
    }

    private static void viewHistory() {
        if (history.isEmpty()) {
            System.out.println("No transactions yet.");
            return;
        }
        System.out.println("\n--- TRANSACTION HISTORY ---");
        for (String line : history) System.out.println(line);
    }

    private static void nextDay() {
        day++;
        System.out.println("\nDay " + day + " price changes:");
        for (Stock s : market.values()) {
            double oldPrice = s.price;
            double change = (random.nextDouble() * 0.10) - 0.05; // -5% to +5%
            s.price = Math.max(1, Math.round(oldPrice * (1 + change) * 100) / 100.0);
            System.out.printf("%-10s %.2f -> %.2f (%+.2f%%)%n", s.symbol, oldPrice, s.price,
                    (s.price - oldPrice) / oldPrice * 100);
        }
    }

    // ---------- Save / load ----------
    private static void savePortfolio() {
        try (PrintWriter out = new PrintWriter(new FileWriter(FILE_NAME))) {
            out.println("STATE|" + cash + "|" + day);
            for (Stock s : market.values()) out.println("PRICE|" + s.symbol + "|" + s.price);
            for (Map.Entry<String, Holding> e : portfolio.entrySet()) {
                out.println("HOLD|" + e.getKey() + "|" + e.getValue().quantity + "|" + e.getValue().totalCost);
            }
            for (String line : history) out.println("TX|" + line);
        } catch (IOException e) {
            System.out.println("Warning: could not save (" + e.getMessage() + ")");
        }
    }

    private static void loadPortfolio() {
        File f = new File(FILE_NAME);
        if (!f.exists()) return;
        try (BufferedReader in = new BufferedReader(new FileReader(f))) {
            String line;
            while ((line = in.readLine()) != null) {
                String[] p = line.split("\\|", 4);
                switch (p[0]) {
                    case "STATE":
                        cash = Double.parseDouble(p[1]);
                        day = Integer.parseInt(p[2]);
                        break;
                    case "PRICE":
                        if (market.containsKey(p[1])) market.get(p[1]).price = Double.parseDouble(p[2]);
                        break;
                    case "HOLD":
                        Holding h = new Holding();
                        h.quantity = Integer.parseInt(p[2]);
                        h.totalCost = Double.parseDouble(p[3]);
                        portfolio.put(p[1], h);
                        break;
                    case "TX":
                        history.add(line.substring(3));
                        break;
                    default:
                        break;
                }
            }
            System.out.println("Loaded your saved portfolio.");
        } catch (IOException | RuntimeException e) {
            System.out.println("Warning: saved file was unreadable. Starting fresh.");
            cash = STARTING_CASH;
            day = 1;
            portfolio.clear();
            history.clear();
        }
    }

    // ---------- Helpers ----------
    private static Stock readStock() {
        System.out.print("Stock symbol: ");
        String sym = sc.nextLine().trim().toUpperCase();
        Stock s = market.get(sym);
        if (s == null) System.out.println("Unknown symbol.");
        return s;
    }

    private static int readInt(String prompt) {
        while (true) {
            System.out.print(prompt);
            try {
                return Integer.parseInt(sc.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.println("Please enter a valid number.");
            }
        }
    }
}
